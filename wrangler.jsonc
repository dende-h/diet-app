{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diet-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diet-app",
      "database_id": "11300b09-8351-434a-a180-21a6bbc4c767",
      "migrations_dir": "migrations"
    }
  ],
  // 朝の体重を量らなかった日の「昨日の振り返り」。UTC 3:00 = 日本時間 12:00。30分後の2回目は、1回目で失敗した人の分だけ作り直す
  "triggers": { "crons": ["0 3 * * *", "30 3 * * *"] },
  "vars": { "PUSH_SUBJECT": "https://diet-app.dende0206.workers.dev" }
  // シークレット（wrangler secret put で設定）: CLERK_SECRET_KEY, ANTHROPIC_API_KEY, DATA_KEY, VAPID_PRIVATE_KEY
}
